{
  "name": "webimg",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:extension": "tsc -b && vite build --config vite.extension.config.ts",
    "watch:extension": "vite build --watch --config vite.extension.config.ts",
    "zip:extension": "npm run build:extension && rm -f webimg-extension.zip && cd dist-extension && zip -qr ../webimg-extension.zip . -x '.DS_Store' && cd .. && ls -l webimg-extension.zip"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "jszip": "^3.10.1",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
